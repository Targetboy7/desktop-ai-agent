{
  "name": "desktop-ai-agent",
  "version": "1.0.0",
  "description": "Desktop AI agent with Claude API integration and Ask & Share workflow",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "build": "electron-builder --win",
    "build:portable": "electron-builder --win portable",
    "build:installer": "electron-builder --win nsis",
    "postinstall": "electron-builder install-app-deps"
  },
  "keywords": [
    "ai",
    "claude",
    "desktop",
    "assistant",
    "productivity"
  ],
  "author": "Targetboy7",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "dotenv": "^16.4.0"
  },
  "devDependencies": {
    "electron": "^31.4.0",
    "electron-builder": "^24.13.1"
  },
  "build": {
    "appId": "com.targetboy7.desktop-ai-agent",
    "productName": "Desktop AI Agent",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!**/*.md",
      "!dist/**",
      "!.env",
      "!.env.example",
      "!node_modules/.cache/**"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "icon.ico",
      "artifactName": "desktop-ai-agent-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico",
      "shortcutName": "Desktop AI Agent"
    }
  }
}
